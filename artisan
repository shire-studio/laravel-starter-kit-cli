#!/usr/bin/env php
<?php

/*
|--------------------------------------------------------------------------
| Laravel Boost Entry Point
|--------------------------------------------------------------------------
|
| Laravel Boost expects an "artisan" file and only runs in the local
| environment. This development entry point boots the application in
| the local environment unless another one is given with "--env".
|
*/

define('LARAVEL_START', microtime(true));

require __DIR__.'/vendor/autoload.php';

$app = require_once __DIR__.'/bootstrap/app.php';

$hasEnvironment = array_filter($_SERVER['argv'], fn (string $argument): bool => str_starts_with($argument, '--env'));

if ($hasEnvironment === []) {
    array_splice($_SERVER['argv'], 1, 0, '--env=local');
}

$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);

$status = $kernel->handle(
    $input = new Symfony\Component\Console\Input\ArgvInput($_SERVER['argv']),
    new Symfony\Component\Console\Output\ConsoleOutput
);

$kernel->terminate($input, $status);

exit($status);
