{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "shire-studio/laravel-starter-kit-cli",
    "description": "Create new projects from the Shire Studio Laravel starter kit and keep existing projects up to date with it.",
    "keywords": ["laravel", "starter kit", "cli"],
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5.0",
        "laravel-zero/foundation": "^13.25",
        "laravel-zero/framework": "^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "larastan/larastan": "^3.13.0",
        "laravel/pint": "^1.32.1",
        "laravel/vet": "^0.2.1",
        "mockery/mockery": "^1.6.15",
        "pestphp/pest": "^5.3.1",
        "pestphp/pest-plugin-phpstan": "^5.2.2",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "phpstan/phpstan": "^2.3.1",
        "rector/rector": "^2.7.0",
        "roave/security-advisories": "dev-latest"
    },
    "conflict": {
        "brianium/paratest": ">=7.26.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@update:requirements"
        ],
        "update:requirements": [
            "composer bump"
        ],
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:unit": "pest --parallel --coverage --exactly=100.0",
        "test:types": "phpstan",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "laravel/vet": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["application"]
}
